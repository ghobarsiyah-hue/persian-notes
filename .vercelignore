# Build output is produced remotely by the Vercel build command —
# never ship local artifacts.
node_modules/
client/dist/
server/dist/
client/node_modules/
server/node_modules/

# local env files (secrets live in the Vercel dashboard)
.env
.env.local
.env.*.local

# dev database + junk
.mongo-data/
*.log
*.mdmp
qa-*
_t_*
_*-tmp.*
.freebuff/

# the bundled 0.9.0 snapshot is not needed for the deploy
/0.9.0/

# Windows launcher helpers are not part of the deploy
START-WINDOWS.bat
README-RUN.txt

# handoff doc (repo-only)
HANDOFF.md

# archives
*.zip
