# ===== Server =====
PORT=4000
NODE_ENV=development

# MongoDB connection. If unreachable and ALLOW_DB_FALLBACK=true (dev only),
# the server starts a PERSISTENT local MongoDB for development:
#   • uses a mongod binary already on the system / user cache if available
#   • otherwise downloads one ONCE via mongodb-memory-server (needs internet)
#   • data is kept in server/.mongo-data and survives restarts
MONGODB_URI=mongodb://127.0.0.1:27017/persian-notes
ALLOW_DB_FALLBACK=true

# Optional: pin the exact mongod binary for the dev fallback (auto-discovered otherwise)
# MONGO_DEV_BINARY=C:\path\to\mongod.exe        (Windows)
# MONGO_DEV_BINARY=/usr/local/bin/mongod        (macOS/Linux)

# Optional: run several copies of the project side by side (parallel checkouts)
# MONGO_DEV_PORT=27018
# PNBIND_API_PORT=4001
# PNBIND_VITE_PORT=5174

# Load demo user + sample notes on first start (default: true in development)
# demo@pernote.local / demo1234
SEED_ON_START=true

# JWT authentication — REPLACE the default in any shared/deployed copy!
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ===== AI =====
# local   : built-in rule-based Persian proofreader (always available, limited to نگارش)
# openai  : any OpenAI-compatible API (OpenAI, OpenRouter, Azure, LM Studio, ...)
AI_PROVIDER=local

# Required only when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=60000
