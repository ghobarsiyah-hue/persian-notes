{
  "name": "persian-notes",
  "private": true,
  "version": "1.0.0",
  "description": "دفترچه یادداشت و جزوه‌نویس فارسی — Persian study-note editor",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,cyan --kill-others \"npm:dev -w server\" \"npm:dev -w client\"",
    "predev": "node scripts/preflight.mjs",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18"
  }
}
